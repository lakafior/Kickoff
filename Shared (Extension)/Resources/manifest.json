{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "images/toolbar-light-16.png",
      "32": "images/toolbar-light-32.png",
      "48": "images/toolbar-light-48.png",
      "64": "images/toolbar-light-64.png"
    },
    "icon_variants": [
      {
        "16": "images/toolbar-light-16.png",
        "32": "images/toolbar-light-32.png",
        "48": "images/toolbar-light-48.png",
        "64": "images/toolbar-light-64.png",
        "color_schemes": [
          "light"
        ]
      },
      {
        "16": "images/toolbar-dark-16.png",
        "32": "images/toolbar-dark-32.png",
        "48": "images/toolbar-dark-48.png",
        "64": "images/toolbar-dark-64.png",
        "color_schemes": [
          "dark"
        ]
      }
    ]
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false,
    "preferred_environment": [
      "document"
    ]
  },
  "content_scripts": [
    {
      "css": [
        "kickoff.css"
      ],
      "js": [
        "strings.js",
        "content.js"
      ],
      "matches": [
        "*://*.kick.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.kick.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.kick.com/*"
      ],
      "resources": [
        "strings.js",
        "page-hook.js"
      ]
    }
  ]
}
