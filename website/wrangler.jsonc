{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kickoff",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  // Routes, not custom domains: a custom domain gets its own certificate that also covers smigi.net,
  // and browsers reusing one connection across *.smigi.net then get 421 Misdirected Request. Routes
  // use the zone's *.smigi.net certificate. Each host needs a proxied DNS record (AAAA 100::).
  "routes": [
    { "pattern": "kickon.smigi.net/*", "zone_name": "smigi.net" },
    // The old name, kept so links from before the rename still work.
    { "pattern": "kickoff.smigi.net/*", "zone_name": "smigi.net" }
  ]
}
